[Unit]
Description=Volk, live Squad objective intel in Discord
Documentation=https://github.com/ernonemacher/volk
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=volk
WorkingDirectory=/opt/volk
ExecStart=/usr/bin/node src/bot.js

# Secrets live outside the repo, readable only by the service user.
EnvironmentFile=/etc/volk.env
Environment=NODE_ENV=production

# glibc hands each thread its own malloc arena, and libvips uses enough threads
# that resident memory climbs and is never handed back. Two arenas is sharp's
# documented mitigation, and on a small instance it is the difference between
# fitting and being killed by the OOM reaper.
Environment=MALLOC_ARENA_MAX=2

# Persisted state, on a directory systemd creates and keeps writable even with
# the hardening below. The repo itself stays read-only.
StateDirectory=volk
Environment=SQUADCALC_STORE=/var/lib/volk/config.json

# Usage and error events. Beside the config on the same writable directory, so
# a backup of /var/lib/volk carries both. Holds Discord user ids, pruned after
# TELEMETRY_RETENTION_DAYS (default 90).
Environment=VOLK_DB=/var/lib/volk/volk_db

# The bot listens on nothing and writes one file, so it can afford to be
# locked down.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
NoNewPrivileges=true
# AF_UNIX included on purpose: without it the service cannot reach the
# journal socket and its logs vanish.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# A gateway bot that dies must come back: a dead process shows a frozen panel
# and tells nobody.
Restart=always
RestartSec=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=volk

[Install]
WantedBy=multi-user.target
