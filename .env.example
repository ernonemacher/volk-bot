# Bot token: discord.com/developers/applications > your app > Bot > Reset Token
DISCORD_TOKEN=

# Optional. Only used the first time a guild starts up, to adopt an existing
# channel; afterwards each guild binds its own channel with /volk setup.
DISCORD_CHANNEL_ID=

# Optional. Where persisted state is written (default: ./config.json).
# Point this at a mounted volume when the host has an ephemeral disk.
SQUADCALC_STORE=

# Optional. SquadCalc API base. Defaults to the beta build, which carries the
# modded layers; use https://squadcalc.app/api to follow the stable one.
SQUADCALC_API=

# Optional. Where usage and error events are recorded (default: ./volk_db).
# Holds Discord user ids; keep it on the same volume as SQUADCALC_STORE.
VOLK_DB=

# Optional. Days an event is kept before the daily sweep drops it (default 90).
TELEMETRY_RETENTION_DAYS=
